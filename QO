title.Parent = frame

local function createButton(name, posY)
	local btn = Instance.new("TextButton")
	btn.Size = UDim2.new(0.85, 0, 0, 35)
	btn.Position = UDim2.new(0.075, 0, 0, posY)
	btn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
	btn.Text = name .. ": OFF"
	btn.TextColor3 = Color3.fromRGB(255, 255, 255)
	btn.TextSize = 13
	btn.Font = Enum.Font.GothamBold
	btn.Parent = frame

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 6)
	btnCorner.Parent = btn
	return btn
end

local btnSpeed = createButton("Speed 40", 45)
local btnEsp = createButton("Nextbot ESP", 90)
local btnInfJump = createButton("Infinite Jump", 135)

local isSpeedEnabled = false
local isEspEnabled = false
local isInfJumpEnabled = false

-- 2. ระบบดันสปีดแบบเจาะเกราะ (ใช้การปรับค่าความเร็วสูงสุดและเพิ่มแรงส่งผ่านเวกเตอร์เมื่อกดเดิน)
task.spawn(function()
	local runService = game:GetService("RunService")
	while true do
		if isSpeedEnabled then
			local character = player.Character
			if character and character:FindFirstChild("Humanoid") and character:FindFirstChild("HumanoidRootPart") then
				local humanoid = character.Humanoid
				-- ดัน WalkSpeed ไปที่ 65 เพื่อให้ระบบเกมยอมปล่อยสปีดให้วิ่งจริงอยู่ที่ประมาณ 40
				humanoid.WalkSpeed = 65
				
				-- บังคับเพิ่มความเร็วผ่านทิศทางการเคลื่อนที่
				if humanoid.MoveDirection.Magnitude > 0 then
					local hrp = character.HumanoidRootPart
					hrp.AssemblyLinearVelocity = Vector3.new(
						humanoid.MoveDirection.X * 40,
						hrp.AssemblyLinearVelocity.Y,
						humanoid.MoveDirection.Z * 40
					)
				end
			end
		end
		runService.RenderStepped:Wait()
	end
end)

btnSpeed.MouseButton1Click:Connect(function()
	isSpeedEnabled = not isSpeedEnabled
	if isSpeedEnabled then
		btnSpeed.Text = "Speed 40: ON"
		btnSpeed.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		btnSpeed.Text = "Speed 40: OFF"
		btnSpeed.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		if player.Character and player.Character:FindFirstChild("Humanoid") then
			player.Character.Humanoid.WalkSpeed = 16
		end
	end
end)

-- 3. ระบบมองทะลุเฉพาะ Nextbot (กรองตัวที่วิ่งไล่ล่าจริงๆ)
local highlights = {}
local function updateNextbotESP()
	for _, obj in pairs(workspace:GetDescendants()) do
		if obj:IsA("Model") and not game.Players:GetPlayerFromCharacter(obj) then
			-- ตรวจสอบว่าเป็น Nextbot มอนสเตอร์ หรือตัวไล่ล่า
			if obj:FindFirstChild("Humanoid") and obj ~= player.Character then
				-- เช็คเงื่อนไขเพิ่มเติมเพื่อไม่ให้จับสิ่งของประกอบฉาก
				if obj.Name ~= "Terrain" and obj:FindFirstChild("HumanoidRootPart") then
					if isEspEnabled then
						if not highlights[obj] then
							local hl = Instance.new("Highlight")
							hl.Adornee = obj
							hl.FillColor = Color3.fromRGB(255, 0, 0) -- สีแดงเด่นชัด
							hl.OutlineColor = Color3.fromRGB(255, 255, 255)
							hl.Parent = obj
							highlights[obj] = hl
						end
					else
						if highlights[obj] then
							highlights[obj]:Destroy()
							highlights[obj] = nil
						end
					end
				end
			end
		end
	end
end

task.spawn(function()
	while true do
		if isEspEnabled then
			updateNextbotESP()
		end
		task.wait(0.5)
	end
end)

btnEsp.MouseButton1Click:Connect(function()
	isEspEnabled = not isEspEnabled
	if isEspEnabled then
		btnEsp.Text = "Nextbot ESP: ON"
		btnEsp.BackgroundColor3 = Color3.fromRGB(50, 200, 50)
	else
		btnEsp.Text = "Nextbot ESP: OFF"
		btnEsp.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
		for _, hl in pairs(highlights) do
			if hl then hl:Destroy() end
		end
		highlights = {}
	end
end)

